# Plantilla de variables de entorno. Copiala a .env y llenala.
#
#   cp .env.example .env
#
# .env esta en .gitignore y no se sube nunca. Este archivo, el de ejemplo, solo
# lleva los NOMBRES: si alguna vez ves un valor real aca, es un incidente.

# --- Base de datos ---------------------------------------------------------
#
# Vacias: el sistema usa el archivo SQLite local (reservas.db). Es lo que
# quieren el desarrollo y las pruebas, y es lo que usa CI.
#
# Llenas: el sistema habla con Turso. Es lo que tiene configurado el despliegue
# en Vercel, y las dos van juntas: una sin la otra falla al arrancar y lo dice.
#
#   turso db show cancha-total-f5 --url      -> TURSO_DATABASE_URL
#   turso db tokens create cancha-total-f5   -> TURSO_AUTH_TOKEN
#
# El token es una credencial: no va a un commit, ni a un README, ni a un log.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Ajustes del sistema (opcionales) ---------------------------------------
#
# Los tres existen desde antes de Turso, por los hallazgos E-1, E-2, E-3 y E-6.
# Sin ellos el sistema arranca igual que siempre.

# Puerto en el que escucha. 0 = uno libre, que es lo que piden las pruebas.
CANCHA_PUERTO=3000

# Ruta del archivo SQLite local. Se ignora si TURSO_DATABASE_URL esta definida.
CANCHA_BD=

# Congela el reloj del sistema en un instante fijo (ISO 8601). Lo usan las
# pruebas y el generador de capturas para dar siempre el mismo resultado.
CANCHA_AHORA=

# --- Verificacion de despliegues protegidos (opcional) ----------------------
#
# Los despliegues de vista previa de Vercel vienen protegidos: un pedido anonimo
# recibe su pantalla de autenticacion en vez de la aplicacion. Esta llave deja
# entrar a la automatizacion sin abrir el despliegue al publico.
#
#   Vercel -> Project Settings -> Deployment Protection
#          -> Protection Bypass for Automation
#
# Solo la usa herramientas/humo.js contra una URL remota. En local no hace falta.
VERCEL_AUTOMATION_BYPASS_SECRET=
