{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.production)"
    ],
    "ask": [
      "Edit(./pruebas/**)",
      "Bash(git push)",
      "Bash(git push *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/verificar.sh\"",
            "timeout": 180,
            "statusMessage": "Verificando antes de cerrar el turno..."
          }
        ]
      }
    ]
  }
}
